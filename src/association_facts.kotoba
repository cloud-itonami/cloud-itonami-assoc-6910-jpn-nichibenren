(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
      (= i 0)
      2
      (= i 1)
      1
      (= i 2)
      1
      (= i 3)
      2
      (= i 4)
      2
      (= i 5)
      2
      (= i 6)
      2
      (= i 7)
      1
      (= i 8)
      2
      (= i 9)
      2
      (= i 10)
      1
      :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
  (cond
    (= i 0)
    (cond
      (= t 0) (option-some-of [:option :string] "ethics")
      (= t 1) (option-some-of [:option :string] "member-conduct")
      :else (option-none-of [:option :string]))
    (= i 1)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 2)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    (= i 3)
    (cond
      (= t 0) (option-some-of [:option :string] "ethics")
      (= t 1) (option-some-of [:option :string] "member-conduct")
      :else (option-none-of [:option :string]))
    (= i 4)
    (cond
      (= t 0) (option-some-of [:option :string] "ethics")
      (= t 1) (option-some-of [:option :string] "member-conduct")
      :else (option-none-of [:option :string]))
    (= i 5)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      (= t 1) (option-some-of [:option :string] "member-conduct")
      :else (option-none-of [:option :string]))
    (= i 6)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      (= t 1) (option-some-of [:option :string] "discipline")
      :else (option-none-of [:option :string]))
    (= i 7)
    (cond
      (= t 0) (option-some-of [:option :string] "member-conduct")
      :else (option-none-of [:option :string]))
    (= i 8)
    (cond
      (= t 0) (option-some-of [:option :string] "anti-money-laundering")
      (= t 1) (option-some-of [:option :string] "member-conduct")
      :else (option-none-of [:option :string]))
    (= i 9)
    (cond
      (= t 0) (option-some-of [:option :string] "anti-money-laundering")
      (= t 1) (option-some-of [:option :string] "member-conduct")
      :else (option-none-of [:option :string]))
    (= i 10)
    (cond
      (= t 0) (option-some-of [:option :string] "governance")
      :else (option-none-of [:option :string]))
    :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "ethics") 3
      (string=? candidate "member-conduct") 7
      (string=? candidate "governance") 5
      (string=? candidate "discipline") 1
      (string=? candidate "anti-money-laundering") 2
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (cond
        (string=? candidate "ethics") (option-some-of [:option :string] "nichibenren.basic-rules-on-duties-of-practicing-attorneys")
        (string=? candidate "member-conduct") (option-some-of [:option :string] "nichibenren.basic-rules-on-duties-of-practicing-attorneys")
        (string=? candidate "governance") (option-some-of [:option :string] "nichibenren.about-jfba-profile")
        (string=? candidate "discipline") (option-some-of [:option :string] "nichibenren.rules-on-disclosure-of-disciplinary-records")
        (string=? candidate "anti-money-laundering") (option-some-of [:option :string] "nichibenren.rules-on-verification-of-client-identity")
        :else (option-none-of [:option :string]))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-6910-jpn-nichibenren (ADR-2607141700): 11 nichibenren entries, each with an official citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
