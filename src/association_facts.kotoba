;; The NICHIBENREN source catalog, as Kotoba.
;;
;; GENERATED from data/datascript-tx.edn, which src/association/facts.cljc
;; reads as data. Both are the same catalog; this one reaches the Kotoba
;; oracle, wasm and both native ISAs, which the .cljc cannot.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every
;; field of every entry against the .cljc, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "nichibenren"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 2 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 2)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "nichibenren.basic-rules-on-duties-of-practicing-attorneys")
        (string=? f "title") (option-some-of [:option :string] "Basic Rules on the Duties of Practicing Attorneys (弁護士職務基本規程, Federation's Rule No. 70)")
        (string=? f "association") (option-some-of [:option :string] "nichibenren")
        (string=? f "isic") (option-some-of [:option :string] "6910")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.nichibenren.or.jp/library/en/about/data/Basic_Rules_Practicing.pdf")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "2004-11-10")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])
        )
      (cond
        (string=? f "id") (option-some-of [:option :string] "nichibenren.about-jfba-profile")
        (string=? f "title") (option-some-of [:option :string] "What is the JFBA? (organization profile)")
        (string=? f "association") (option-some-of [:option :string] "nichibenren")
        (string=? f "isic") (option-some-of [:option :string] "6910")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://www.nichibenren.or.jp/en/about/us/profile.html")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1949-09-01")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])
        )
      )
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (if (= i 0) 2 (if (= i 1) 1 0))
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (if (= t 0) (option-some-of [:option :string] "ethics") (if (= t 1) (option-some-of [:option :string] "member-conduct") (option-none-of [:option :string])))
    (if (= i 1)
      (if (= t 0) (option-some-of [:option :string] "governance") (option-none-of [:option :string]))
    (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (if (string=? candidate "ethics") 1 (if (string=? candidate "member-conduct") 1 (if (string=? candidate "governance") 1 0)))
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (if (string=? candidate "ethics") (entry-field a 0 "id") (if (string=? candidate "member-conduct") (entry-field a 0 "id") (if (string=? candidate "governance") (entry-field a 1 "id") (option-none-of [:option :string]))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-6910-jpn-nichibenren Wave 0 (ADR-2607141700): 2 nichibenren entries seeded with an official citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
